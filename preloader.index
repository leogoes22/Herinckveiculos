<!DOCTYPE html><html><head><meta charset="utf-8">
<style>
body{background:#080706;display:grid;place-items:center;height:100vh;margin:0}
:root{
  --bg:#0b0a09;--bg-2:#121010;--card:#171413;--card-2:#1e1a18;--line:#2e2521;
  --cor:#d65945;--cor-soft:#c4503e;--cor-light:#f0836e;--cor-deep:#8c3325;
  --txt:#efecdf;--txt-mut:#a79c90;--txt-dim:#6d635a;--ok:#25d366;
  --logo:url("data:image/png;base64,");
  --simbolo:url("data:image/png;base64,");
}
.pl-logo{position:relative;width:132px;height:188px;background:var(--simbolo) no-repeat center/contain;
  filter:drop-shadow(0 0 26px rgba(214,89,69,.45));animation:plpulse 2.4s ease-in-out infinite}
/* luz neon varrendo o simbolo — recortada pela propria silhueta */
.pl-shine{position:absolute;inset:0;pointer-events:none;mix-blend-mode:screen;
  -webkit-mask:var(--simbolo) no-repeat center/contain;mask:var(--simbolo) no-repeat center/contain;
  background:linear-gradient(105deg,
    transparent 38%, rgba(255,236,225,.15) 45%, rgba(255,255,255,.92) 50%,
    rgba(255,236,225,.15) 55%, transparent 62%);
  background-size:260% 100%;background-position:200% 0;
  animation:plneon 2.4s cubic-bezier(.5,0,.5,1) infinite}
@keyframes plneon{0%{background-position:200% 0}60%,100%{background-position:-120% 0}
.pl-txt{font-family:sans-serif;font-weight:500;letter-spacing:.4em;color:#f0836e;font-size:.72rem;text-transform:uppercase;margin-top:26px;text-align:center}
</style></head><body>
<div>
  <div class="pl-logo" role="img"><span class="pl-shine"></span></div>
  <div class="pl-txt">Carregando estoque</div>
</div>
</body></html>
